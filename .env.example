# 로컬 개발용 기본값. prod는 systemd EnvironmentFile로 주입.

APP_ENV=dev
APP_ADDR=:8080
LOG_LEVEL=info

# SQLite 파일 경로 (상대경로 → 절대경로 변환)
DB_PATH=./var/yuhada.db

# V2 (TEST 환경) — 별도 PIN + 격리된 v2_ prefix 테이블
# DB_V2_PATH 를 v1 DB(DB_PATH)와 동일 파일로 지정하면 v2_* 테이블만 추가되어 공존 가능.
# 별도 파일로 두면 완전 물리 격리 (기본).
DB_V2_PATH=./var/yuhada-v2.db
ADMIN_PIN_V2=

# V2 prod 시연 모드 — 기본은 prod 에서 마운트 안 됨. 시연 시 true 로 opt-in.
V2_ENABLE=false

# V2 카카오 로그인 (선택). 미설정 시 로그인 페이지에 카카오 버튼 미노출 → PIN 만.
#   - KAKAO_CLIENT_ID/SECRET 는 v1 과 공유 (같은 앱).
#   - REDIRECT_V2 는 개발자 콘솔의 REST API 키 설정에 동일한 리다이렉트 URI 를 등록.
#   - ADMIN_KAKAO_EMAILS_V2: 쉼표로 구분한 이메일 목록. 설정하면 ID 대신 이메일로 판단.
#     예: owner@example.com,manager@example.com
#     콘솔에서 카카오계정(이메일) 동의항목 사용 설정 필요. 유효하고 인증된 이메일만 허용.
#   - 이메일 목록이 비어 있을 때만 ADMIN_KAKAO_ID_V2 로 판단 (기존 환경 호환).
#     두 목록 모두 미설정이면 관리자 등록 안내만 표시하고 로그인은 허용하지 않음.
KAKAO_REDIRECT_V2=https://yuhadahair.cafe24.com/v2/kakao/callback
ADMIN_KAKAO_EMAILS_V2=
ADMIN_KAKAO_ID_V2=

# 세션 쿠키 서명 (dev에서는 임의값 OK, prod는 32B 이상 무작위)
SESSION_SECRET=dev-secret-change-me-in-production-0000000000

# 쿠키 보안 (prod=true; https 필수)
COOKIE_SECURE=false

# 첫 실행 시 관리자 부트스트랩.
# email: 식별자 (DB unique key, 로그인 화면에는 노출 X — PIN으로만 인증)
# pin:   6자리. 로그인 시 사용하는 메인 인증 수단.
# pw:    선택. fallback 비번 (현재 로그인 UI는 PIN만 노출)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PIN=
ADMIN_BOOTSTRAP_PW=

# 알리고 SMS API (빈값이면 SMS 비활성)
# API 키 발급: https://smartsms.aligo.in
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# PII 암호화 키 (32바이트 = 64 hex chars). 빈값이면 암호화 비활성.
# 생성: openssl rand -hex 32
ENCRYPTION_KEY=

# Kakao OAuth (Step 11)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URL=https://yhd.cafe24.com/c/kakao/callback
