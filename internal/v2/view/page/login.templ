package page

import (
	"net/url"

	"github.com/mingicho/yuhada/internal/v2/view/layout"
)

// Login — /v2/login. 허용된 카카오 계정으로만 로그인한다.
templ Login(p LoginProps) {
	@layout.Bare("로그인") {
		<main class="min-h-screen flex flex-col items-center justify-center">
			<div class="w-full max-w-admin-login-card px-8">
				<div class="flex flex-col items-start mb-12 leading-none">
					<span class="font-display italic text-[40px] tracking-wide-serif">yhd</span>
					<span class="mt-2 font-display text-[10px] tracking-[0.22em] uppercase">YUHADA HAIR</span>
				</div>
				<h1 class="yh-headline-l text-[26px] sm:text-[32px] mb-2">로그인</h1>
				if p.KakaoEnabled {
					<p class="yh-body-sm text-ink-500 mb-10">허용된 카카오 계정으로 로그인해 주세요.</p>
					@kakaoButton(p.Next)
					<p class="text-[12px] text-ink-500 mt-4">등록되지 않은 계정은 관리자 화면에 접근할 수 없습니다.</p>
				} else {
					<p class="yh-body-sm text-ink-500 mt-2">카카오 로그인 설정이 필요합니다. 관리자에게 문의해 주세요.</p>
				}
				if p.ErrorMsg != "" {
					<p class="text-[12px] text-danger mt-4" role="alert">{ p.ErrorMsg }</p>
				}
			</div>
		</main>
	}
}

// kakaoButton — 허용된 카카오 계정으로 관리자 인증을 시작한다.
templ kakaoButton(next string) {
	<a
		href={ templ.SafeURL(kakaoLoginHref(next)) }
		class="w-full flex items-center justify-center gap-2 bg-[#FEE500] text-ink-900 py-3 rounded-md text-[15px] font-medium hover:brightness-95 transition"
	>
		<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M10 3C5.58 3 2 5.86 2 9.35c0 2.19 1.4 4.11 3.55 5.24l-.68 2.5c-.06.22.18.4.38.28l3-1.97c.58.08 1.16.13 1.75.13 4.42 0 8-2.86 8-6.35S14.42 3 10 3z" fill="#1A1614"/>
		</svg>
		카카오로 로그인
	</a>
}

func kakaoLoginHref(next string) string {
	if next == "" {
		return "/v2/kakao/login"
	}
	return "/v2/kakao/login?next=" + url.QueryEscape(next)
}
