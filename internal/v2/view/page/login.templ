package page

import (
	"fmt"

	"github.com/mingicho/yuhada/internal/v2/view/layout"
)

// Login — /v2/login. PIN 6자리 입력. v1 톤 재사용.
templ Login(p LoginProps) {
	@layout.Bare("로그인") {
		<main class="min-h-screen flex flex-col items-center justify-center">
			<div class="w-full max-w-admin-login-card px-8">
				<div class="flex flex-col items-start mb-12 leading-none">
					<span class="font-display italic text-[40px] tracking-wide-serif">yhd v2</span>
					<span class="mt-2 font-display text-[10px] tracking-[0.22em] uppercase">YUHADA HAIR · TEST</span>
				</div>
				<h1 class="yh-headline-l text-[26px] sm:text-[32px]">로그인</h1>
				<p class="yh-body-sm text-ink-500 mb-10 mt-2">v2 관리자 PIN 을 입력하세요.</p>

				@loginForm(p)
			</div>
		</main>
	}
}

// loginForm — v2 PIN 입력. 6칸 시각화 + 6자리 채워지면 자동 submit.
// next 파라미터가 있으면 hidden input 로 보존한다.
templ loginForm(p LoginProps) {
	<form
		method="POST"
		action="/v2/login"
		class="flex flex-col gap-6"
		hx-boost="false"
		x-data="{ pin: '' }"
	>
		if p.Next != "" {
			<input type="hidden" name="next" value={ p.Next }/>
		}
		<div>
			<label class="yh-label" for="pin">PIN</label>
			<div class="relative" x-on:click="$refs.pinInput.focus()">
				<input
					id="pin"
					name="pin"
					type="password"
					inputmode="numeric"
					pattern="[0-9]{4,6}"
					maxlength="6"
					autocomplete="off"
					autofocus
					required
					x-ref="pinInput"
					x-model="pin"
					x-on:input="pin = pin.replace(/\D/g,'').slice(0,6); if (pin.length >= 4) { /* enter 로 submit 허용 */ }"
					class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
				/>
				<div class="grid grid-cols-6 gap-3 pointer-events-none select-none">
					for i := 0; i < 6; i++ {
						@pinBox(i)
					}
				</div>
			</div>
		</div>

		<div class="min-h-[20px] text-[12px] text-danger">
			if p.ErrorMsg != "" {
				{ p.ErrorMsg }
			}
		</div>

		<button type="submit" class="yh-btn yh-btn-primary yh-btn-lg w-full" x-bind:disabled="pin.length < 4">
			로그인
		</button>
	</form>
}

templ pinBox(idx int) {
	<div
		class="h-14 border-b-2 flex items-center justify-center transition-colors duration-150"
		x-bind:class={ pinBoxBorder(idx) }
	>
		<span
			x-show={ fmt.Sprintf("pin.length > %d", idx) }
			x-transition:enter="transition ease-out duration-150"
			x-transition:enter-start="opacity-0 scale-50"
			x-transition:enter-end="opacity-100 scale-100"
			class="w-2.5 h-2.5 rounded-full bg-ink-900"
		></span>
	</div>
}

func pinBoxBorder(i int) string {
	return fmt.Sprintf(
		"pin.length > %d ? 'border-ink-900' : (pin.length === %d ? 'border-ink-900' : 'border-sand-300')",
		i, i,
	)
}
