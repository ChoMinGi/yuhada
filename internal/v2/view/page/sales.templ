package page

import (
	"strconv"

	"github.com/mingicho/yuhada/internal/v2/view/component"
	"github.com/mingicho/yuhada/internal/v2/view/layout"
)

// Sales — 선택 기간의 성과와 현재 고객 잔액을 구분하는 운영 대시보드.
templ Sales(p SalesProps) {
	@layout.Admin("매출", "sales") {
		<div id="sales-dashboard" class="px-4 py-5 sm:px-8 sm:py-10 max-w-admin-content mx-auto">
			<header class="mb-6 sm:mb-8">
				<p class="yh-eyebrow mb-2 sm:mb-3">MEMBERSHIP</p>
				<h1 class="yh-headline-l text-[26px] sm:text-[32px]">매출 대시보드</h1>
				<p class="yh-body-sm mt-2 text-ink-500">판매 흐름과 시술 사용을 비교하고, 잔액을 살펴보세요.</p>
				<a href="/v2/admin/retention" class="inline-flex items-center gap-2 mt-3 text-[13px] text-ink-700 underline underline-offset-4">
					<span>고객 재방문·유지율 보기</span>
					@component.Icon("chevron-right", 14)
				</a>
			</header>
			<!-- 기간 필터 (dashboard 와 동일 스타일 + '기간 지정' 토글) -->
			<div x-data={ salesFilterAlpine(p.Period) }>
				<nav class="inline-flex flex-wrap bg-sand-100 rounded-md p-1 mb-3 gap-y-1" aria-label="기간 필터">
					@salesPeriodTab(p.Period, "today", "오늘")
					@salesPeriodTab(p.Period, "this-week", "이번 주")
					@salesPeriodTab(p.Period, "this-month", "이번 달")
					@salesPeriodTab(p.Period, "all", "전체")
					<button
						type="button"
						x-on:click="showCustom = !showCustom"
						x-bind:class="showCustom ? 'bg-ink-900 text-sand-50' : 'text-ink-700 hover:bg-sand-200/60'"
						class="px-3 sm:px-4 py-1.5 rounded text-[13px] sm:text-[14px] transition"
					>기간 지정</button>
				</nav>

				<!-- 커스텀 기간 폼 (초기: p.Period=='custom' 일 때만 표시) -->
				<form
					x-show="showCustom"
					x-cloak
					x-transition:enter="transition ease-out duration-150"
					x-transition:enter-start="opacity-0 -translate-y-1"
					x-transition:enter-end="opacity-100 translate-y-0"
					method="GET"
					action="/v2/admin/sales"
					class="flex flex-col sm:flex-row sm:items-center gap-2 mb-8 sm:mb-10"
				>
					<input type="hidden" name="period" value="custom"/>
					<div class="flex items-center gap-2 min-w-0">
						<input
							type="date"
							name="from"
							value={ p.PeriodFrom }
							class={ "flex-1 min-w-0 px-3 py-1.5 rounded border text-[13px] sm:text-[14px] bg-sand-50 focus:outline-none",
								templ.KV("border-ink-900", p.Period == "custom"),
								templ.KV("border-sand-300", p.Period != "custom") }
						/>
						<span class="text-ink-500 text-[13px] shrink-0">~</span>
						<input
							type="date"
							name="to"
							value={ p.PeriodTo }
							class={ "flex-1 min-w-0 px-3 py-1.5 rounded border text-[13px] sm:text-[14px] bg-sand-50 focus:outline-none",
								templ.KV("border-ink-900", p.Period == "custom"),
								templ.KV("border-sand-300", p.Period != "custom") }
						/>
					</div>
					<button
						type="submit"
						class="px-3 sm:px-4 py-2 sm:py-1.5 rounded text-[13px] sm:text-[14px] transition shrink-0 bg-ink-900 text-sand-50"
					>적용</button>
				</form>

				<!-- 폼이 닫혔을 때 여백 유지 -->
				<div x-show="!showCustom" class="mb-8 sm:mb-10"></div>
			</div>


			<section aria-labelledby="sales-period-heading" class="mb-8 sm:mb-10">
				<div class="flex items-end justify-between gap-4 mb-4">
					<div>
						<p class="yh-eyebrow-xs text-ink-500 mb-2">선택한 기간</p>
						<h2 id="sales-period-heading" class="yh-headline-s">{ p.PeriodLabel }</h2>
					</div>
				</div>
				<div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 mb-4">
					@salesSummaryCard("판매 금액", p.SummaryCards.RealRevenue, p.SummaryCards.TxCount + " 충전 · 정액권 보너스 제외", true)
					@salesSummaryCard("시술 사용액", p.Insights.UsageTotal, "시술 차감액 · 결제 매출 아님", false)
					@salesSummaryCard("시술 고객", p.Insights.VisitorCount, "중복 제외 · 차감 " + p.Insights.VisitCount, false)
					@salesSummaryCard("재충전 비중", salesRechargeDisplay(p.Insights), strconv.Itoa(p.Insights.RepeatCount) + "건 / 전체 " + strconv.Itoa(p.Insights.FirstCount + p.Insights.RepeatCount) + "건", false)
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
					<div class="yh-card p-4 sm:p-6 lg:col-span-2">
						<div class="flex flex-wrap items-start justify-between gap-3 mb-4">
							<div>
								<h3 class="yh-eyebrow">판매와 시술 사용</h3>
								<p class="text-[12px] text-ink-500 mt-2">선택한 기간 전체 · { p.Insights.TrendGranularity } 합계</p>
							</div>
							<span class="text-[11px] text-ink-500">금액 단위: 만원</span>
						</div>
						<div class="relative" style="height:280px">
							<canvas id="sales-comparison-chart" data-labels={ p.Insights.TrendLabelsJSON } data-sales={ p.Insights.TrendSalesJSON } data-usage={ p.Insights.TrendUsageJSON } role="img" aria-label="선택 기간의 판매 금액과 시술 사용액 비교. 아래 기간별 수치에서 같은 값을 확인할 수 있습니다."></canvas>
						</div>
						<p id="sales-chart-status" class="text-[12px] text-ink-500 mt-3" role="status">그래프를 불러오는 중입니다. 아래 기간별 수치에서도 확인할 수 있습니다.</p>
						<p class="text-[12px] text-ink-500 mt-3">시술 사용액은 고객 잔액에서 차감한 금액이며, 새로 받은 결제 금액이 아닙니다.</p>
						@salesTrendTable(p.Insights)
					</div>
					@salesRechargeCard(p.Insights)
				</div>
			</section>

			<section aria-labelledby="sales-current-heading" class="mb-8 sm:mb-10 pt-8 border-t border-sand-300">
				<div class="mb-4">
					<p class="yh-eyebrow-xs text-ink-500 mb-2">현재 기준 · 기간 필터와 무관</p>
					<h2 id="sales-current-heading" class="yh-headline-s">고객 잔액 관리</h2>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
					@salesBalanceCard(p.Insights)
					@salesLowBalanceCard(p.Insights)
				</div>
			</section>

			<section aria-labelledby="sales-history-heading">
				<div class="mb-4">
					<p class="yh-eyebrow-xs text-ink-500 mb-2">선택한 기간 · { p.PeriodLabel }</p>
					<h2 id="sales-history-heading" class="yh-headline-s">판매 상세</h2>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
					@salesTopMembersCard(p.TopMembers)
					@salesRecentCard(p.RecentSales)
				</div>
				if salesHasPlanRows(p.TierRows) {
					<details class="yh-card mt-4">
						<summary class="p-4 sm:p-5 cursor-pointer text-[13px] text-ink-700">정액권 상품별 판매 보기</summary>
						<div class="divide-y divide-sand-200">
							for _, row := range p.TierRows {
								if !row.IsGeneric {
									@salesTierRow(row)
								}
							}
						</div>
					</details>
				}
			</section>

			<script>
				(function () {
					if (window.__yhSalesChartDispose) window.__yhSalesChartDispose();
					const host = document.getElementById('sales-dashboard');
					const canvas = document.getElementById('sales-comparison-chart');
					if (!host || !canvas) return;
					let chart = null, timer = null, attempts = 0, disposed = false;
					const status = document.getElementById('sales-chart-status');
					function dispose() {
						disposed = true;
						if (timer) clearTimeout(timer);
						if (chart) { chart.destroy(); chart = null; }
						document.removeEventListener('htmx:beforeCleanupElement', onCleanup);
						document.removeEventListener('htmx:afterSettle', init);
					}
					function onCleanup(event) {
						const element = event.detail && event.detail.elt;
						if (element && (element === host || element.contains(host))) dispose();
					}
					function init() {
						if (disposed || chart || !host.isConnected) return;
						if (timer) { clearTimeout(timer); timer = null; }
						if (typeof window.Chart === 'undefined') {
							if (++attempts <= 60) timer = setTimeout(init, 100);
							else if (status) status.textContent = '그래프를 불러오지 못했습니다. 아래 기간별 수치에서 확인해 주세요.';
							return;
						}
						try {
							const labels = JSON.parse(canvas.dataset.labels || '[]');
							const sales = JSON.parse(canvas.dataset.sales || '[]');
							const usage = JSON.parse(canvas.dataset.usage || '[]');
							if (!Array.isArray(labels) || !Array.isArray(sales) || !Array.isArray(usage)) throw new Error('Invalid chart data');
							const existing = window.Chart.getChart ? window.Chart.getChart(canvas) : null;
							if (existing) existing.destroy();
							chart = new window.Chart(canvas, {
								type: 'bar',
								data: { labels: labels, datasets: [
									{ label: '판매 금액', data: sales, backgroundColor: '#1A1614', borderRadius: 3, maxBarThickness: 24 },
									{ label: '시술 사용액', data: usage, backgroundColor: '#B89472', borderRadius: 3, maxBarThickness: 24 }
								] },
								options: {
									responsive: true, maintainAspectRatio: false,
									interaction: { mode: 'index', intersect: false },
									plugins: {
										legend: { position: 'bottom', labels: { color: '#4A3F38', boxWidth: 12, padding: 16, font: { family: "'Pretendard Variable','Pretendard',sans-serif", size: 12 } } },
										tooltip: { callbacks: { label: function (item) { return item.dataset.label + ': ₩' + Number(item.parsed.y || 0).toLocaleString('ko-KR'); } } }
									},
									scales: {
										y: { beginAtZero: true, grid: { color: '#E8D5BC' }, ticks: { color: '#4A3F38', callback: function (value) { return (Number(value) / 10000).toLocaleString('ko-KR', { maximumFractionDigits: 1 }); } } },
										x: { grid: { display: false }, ticks: { color: '#4A3F38', maxRotation: 0, autoSkip: true, maxTicksLimit: 8 } }
									}
								}
							});
							if (status) status.hidden = true;
						} catch (_) {
							if (status) status.textContent = '그래프를 표시하지 못했습니다. 아래 기간별 수치에서 확인해 주세요.';
						}
					}
					window.__yhSalesChartDispose = dispose;
					document.addEventListener('htmx:beforeCleanupElement', onCleanup);
					document.addEventListener('htmx:afterSettle', init);
					init();
				})();
			</script>
		</div>
	}
}

templ salesRechargeCard(p SalesInsightsProps) {
	<div class="yh-card p-4 sm:p-6">
		<h3 class="yh-eyebrow">첫 충전과 재충전</h3>
		<p class="text-[12px] text-ink-500 mt-2">고객 수가 아닌 충전 건수 기준</p>
		if p.FirstCount + p.RepeatCount > 0 {
			<div class="flex h-5 rounded overflow-hidden bg-sand-200 mt-6" role="img" aria-label={ "첫 충전 " + strconv.Itoa(p.FirstCount) + "건, 재충전 " + strconv.Itoa(p.RepeatCount) + "건" }>
				<div class="bg-sand-300 h-full" style={ "width:" + strconv.Itoa(p.FirstPercent) + "%" }></div>
				<div class="bg-ink-900 h-full" style={ "width:" + strconv.Itoa(p.RechargePercent) + "%" }></div>
			</div>
		} else {
			<p class="text-[13px] text-ink-500 py-6">이 기간의 충전 기록이 없습니다.</p>
		}
		<dl class="mt-5 divide-y divide-sand-200">
			<div class="py-4">
				<dt class="text-[13px] text-ink-700 flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm bg-sand-300"></span>첫 충전</dt>
				<dd class="mt-2 flex items-baseline justify-between gap-2"><span class="yh-num text-[22px]">{ strconv.Itoa(p.FirstCount) }<span class="text-[12px] text-ink-500 ml-1">건</span></span><span class="text-[13px] tabular-nums">{ p.FirstAmount }</span></dd>
			</div>
			<div class="py-4">
				<dt class="text-[13px] text-ink-700 flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm bg-ink-900"></span>재충전</dt>
				<dd class="mt-2 flex items-baseline justify-between gap-2"><span class="yh-num text-[22px]">{ strconv.Itoa(p.RepeatCount) }<span class="text-[12px] text-ink-500 ml-1">건</span></span><span class="text-[13px] tabular-nums">{ p.RepeatAmount }</span></dd>
			</div>
		</dl>
		<p class="text-[11px] text-ink-500 mt-3">전체 거래 이력에서 첫 충전 이후의 충전을 재충전으로 봅니다. 고객 이탈률을 뜻하지 않습니다.</p>
	</div>
}

templ salesBalanceCard(p SalesInsightsProps) {
	<div class="yh-card p-4 sm:p-6">
		<h3 class="yh-eyebrow">현재 고객 잔액</h3>
		<p class="yh-num text-[28px] sm:text-[32px] mt-4">{ p.CurrentBalance }</p>
		<p class="text-[12px] text-ink-500 mt-2">고객 { strconv.Itoa(p.CurrentMemberCount) }명 기준 · 기간 내 충전 합계가 아닙니다.</p>
		<div class="mt-6 space-y-5">
			for _, bucket := range p.BalanceBuckets {
				<div>
					<div class="flex flex-wrap justify-between gap-2 text-[12px] mb-2">
						<span class="text-ink-700">{ bucket.Label }</span>
						<span class="tabular-nums text-ink-700">{ strconv.Itoa(bucket.Count) }명 · { bucket.Amount }</span>
					</div>
					<div class="h-2.5 rounded-full bg-sand-100 overflow-hidden" aria-hidden="true"><div class="h-full rounded-full bg-ink-700" style={ "width:" + strconv.Itoa(bucket.Percent) + "%" }></div></div>
				</div>
			}
		</div>
		<p class="text-[11px] text-ink-500 mt-5">막대는 잔액 구간별 고객 수 비중입니다.</p>
	</div>
}

templ salesLowBalanceCard(p SalesInsightsProps) {
	<div class="yh-card overflow-hidden">
		<div class="p-4 sm:p-6 border-b border-sand-200">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<h3 class="yh-eyebrow">재충전 안내 후보</h3>
				<span class="text-[12px] text-ink-500">{ strconv.Itoa(p.LowBalanceCount) }명</span>
			</div>
			<p class="text-[12px] text-ink-500 mt-2">잔액 5만원 이하 · 최근 60일 안에 시술한 고객</p>
		</div>
		if len(p.LowBalance) == 0 {
			<p class="text-[13px] text-ink-500 p-6">현재 조건에 해당하는 고객이 없습니다.</p>
		} else {
			<ul class="divide-y divide-sand-200">
				for _, member := range p.LowBalance {
					<li>
						<a href={ templ.SafeURL("/v2/admin/members/" + member.MemberID) } class="flex items-center gap-3 px-4 sm:px-6 py-4 hover:bg-sand-100 transition">
							<div class="flex-1 min-w-0"><p class="text-[14px] text-ink-900 truncate">{ member.Name }</p><p class="text-[11px] text-ink-500 mt-1">최근 시술 { member.LastVisit }</p></div>
							<p class="yh-num text-[16px] shrink-0">{ member.Balance }</p>
							@component.Icon("chevron-right", 14)
						</a>
					</li>
				}
			</ul>
			<p class="text-[11px] text-ink-500 px-4 sm:px-6 py-4 border-t border-sand-200">잔액이 적은 순으로 최대 5명 표시 · 고객을 눌러 이력을 확인하세요.</p>
		}
	</div>
}

templ salesTrendTable(p SalesInsightsProps) {
	<details class="mt-4 border-t border-sand-200 pt-4">
		<summary class="text-[12px] text-ink-700 cursor-pointer">기간별 수치 보기</summary>
		<div class="overflow-x-auto mt-3">
			<table class="w-full text-[12px] text-right tabular-nums">
				<caption class="text-left text-[11px] text-ink-500 mb-2">그래프와 같은 수치 · 원</caption>
				<thead><tr class="border-b border-sand-200"><th scope="col" class="text-left py-2 font-medium">기간</th><th scope="col" class="py-2 font-medium">판매 금액</th><th scope="col" class="py-2 font-medium">시술 사용액</th></tr></thead>
				<tbody>
					for _, row := range p.TrendRows {
						<tr class="border-b border-sand-100"><th scope="row" class="text-left py-2 font-normal whitespace-nowrap">{ row.Label }</th><td class="py-2 pl-3 whitespace-nowrap">{ row.Sales }</td><td class="py-2 pl-3 whitespace-nowrap">{ row.Usage }</td></tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}

func salesRechargeDisplay(p SalesInsightsProps) string {
	if p.FirstCount + p.RepeatCount == 0 { return "—" }
	return strconv.Itoa(p.RechargePercent) + "%"
}

func salesHasPlanRows(rows []SalesTierRow) bool {
	for _, row := range rows { if !row.IsGeneric { return true } }
	return false
}

// salesFilterAlpine — '기간 지정' 토글 상태.
// 초기값: 현재 period 가 custom 이면 폼 표시, 아니면 접힘.
func salesFilterAlpine(period string) string {
	initial := "false"
	if period == "custom" {
		initial = "true"
	}
	return "{ showCustom: " + initial + " }"
}

// salesPeriodTab — 기간 탭 링크 (dashboard 의 dashPeriodTab 과 동일 스타일).
templ salesPeriodTab(current, key, label string) {
	<a
		href={ templ.SafeURL("/v2/admin/sales?period=" + key) }
		class={ "px-3 sm:px-4 py-1.5 rounded text-[13px] sm:text-[14px] transition",
			templ.KV("bg-ink-900 text-sand-50", current == key),
			templ.KV("text-ink-700 hover:bg-sand-200/60", current != key) }
	>{ label }</a>
}

// salesSummaryCard — KPI 카드 한 장. primary 인 첫 카드만 검은 배경.
templ salesSummaryCard(label, value, sub string, primary bool) {
	<div
		class={ "yh-card p-4 sm:p-5",
			templ.KV("bg-ink-900 text-sand-50", primary) }
	>
		<p
			class={ "yh-eyebrow-xs mb-2",
				templ.KV("text-sand-200", primary),
				templ.KV("text-ink-500", !primary) }
		>{ label }</p>
		<p
			class={ "yh-num text-[20px] sm:text-[24px]",
				templ.KV("text-sand-50", primary),
				templ.KV("text-ink-900", !primary) }
		>{ value }</p>
		if sub != "" {
			<p
				class={ "text-[11px] mt-1",
					templ.KV("text-sand-200/80", primary),
					templ.KV("text-ink-500", !primary) }
			>{ sub }</p>
		}
	</div>
}

// salesTopMembersCard — TOP 회원 위젯 (rank 뱃지 + 이름 + 건수 + 금액).
templ salesTopMembersCard(rows []SalesTopMember) {
	<section class="yh-card p-5 sm:p-6">
		<div class="flex items-center justify-between mb-4">
			<h2 class="yh-eyebrow">TOP 회원</h2>
			<span class="text-[11px] text-ink-500">이 기간</span>
		</div>
		if len(rows) == 0 {
			<p class="text-center text-[13px] text-ink-500 py-8">판매 없음</p>
		} else {
			<ul class="divide-y divide-sand-200">
				for _, m := range rows {
					<li class="flex items-center gap-3 py-3">
						<span
							class={ "w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-medium shrink-0 tabular-nums",
								templ.KV("bg-ink-900 text-sand-50", m.Rank == 1),
								templ.KV("bg-sand-200 text-ink-900", m.Rank != 1) }
						>{ strconv.Itoa(m.Rank) }</span>
						<a
							href={ templ.SafeURL("/v2/admin/members/" + m.MemberID) }
							class="flex-1 min-w-0 hover:opacity-80 transition"
						>
							<p class="text-[14px] font-medium text-ink-900 truncate">{ m.Name }</p>
							<p class="text-[11px] text-ink-500">{ m.Count }</p>
						</a>
						<p class="yh-num text-[14px] sm:text-[15px] text-ink-900 shrink-0 tabular-nums">{ m.TotalPrice }</p>
					</li>
				}
			</ul>
		}
	</section>
}

// salesRecentCard — 최근 판매 이력 카드 (하단 우측).
templ salesRecentCard(rows []SalesRecentRow) {
	<section class="yh-card overflow-hidden">
		<div class="flex items-center justify-between px-5 sm:px-6 pt-5 sm:pt-6 pb-3">
			<h2 class="yh-eyebrow">최근 판매 이력</h2>
			<span class="text-[11px] text-ink-500">최근 { strconv.Itoa(len(rows)) }건</span>
		</div>
		if len(rows) == 0 {
			<p class="text-center text-[13px] text-ink-500 py-8 px-6">표시할 판매가 없습니다.</p>
		} else {
			<ul class="divide-y divide-sand-200">
				for _, r := range rows {
					@salesRecentRow(r)
				}
			</ul>
		}
	</section>
}

// salesTierRow — 등급 리스트 한 줄.
templ salesTierRow(row SalesTierRow) {
	<div
		class={ "flex flex-col gap-2 p-4 sm:p-5",
			templ.KV("bg-sand-50/50", row.IsGeneric) }
	>
		<div class="flex items-center justify-between gap-3">
			<div class="flex items-center gap-2 flex-wrap min-w-0">
				<p class="text-[14px] sm:text-[15px] text-ink-900 font-medium">{ row.TierLabel }</p>
				if !row.IsGeneric && row.PayMethod != "" {
					<span class="inline-flex items-center px-1.5 py-0.5 rounded-sm bg-sand-100 text-[10px] tracking-brand uppercase text-ink-700 shrink-0">{ payMethodLabel(row.PayMethod) }</span>
				}
			</div>
			<p class="text-[12px] text-ink-500 tabular-nums shrink-0">{ row.CountLabel }</p>
		</div>
		<div class="grid grid-cols-3 gap-2 text-right">
			<div>
				<p class="text-[10px] tracking-brand uppercase text-ink-500">판매 금액</p>
				<p class="yh-num text-[14px] sm:text-[15px] text-ink-900">{ row.TotalPrice }</p>
			</div>
			<div>
				<p class="text-[10px] tracking-brand uppercase text-ink-500">적립</p>
				<p class="yh-num text-[14px] sm:text-[15px] text-ink-900">{ row.TotalCredit }</p>
			</div>
			<div>
				<p class="text-[10px] tracking-brand uppercase text-ink-500">보너스</p>
				if row.HasBonus {
					<p class="yh-num text-[14px] sm:text-[15px] text-success">{ row.TotalBonus }</p>
				} else {
					<p class="yh-num text-[14px] sm:text-[15px] text-ink-500">—</p>
				}
			</div>
		</div>
	</div>
}

// salesRecentRow — 최근 판매 이력 한 줄.
templ salesRecentRow(r SalesRecentRow) {
	<li class="flex items-center gap-3 sm:gap-4 px-5 sm:px-6 py-3.5 hover:bg-sand-50 transition">
		<div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 bg-sand-50 text-success">
			@component.Icon("trending-up", 14)
		</div>
		<a
			href={ templ.SafeURL("/v2/admin/members/" + r.MemberID) }
			class="flex-1 min-w-0"
		>
			<p class="text-[14px] font-medium text-ink-900 truncate">{ r.MemberName }</p>
			<p class="text-[11px] text-ink-500 mt-0.5 flex items-center gap-1.5 flex-wrap">
				if r.IsGeneric {
					<span>일반 충전 · 결제수단 미상</span>
				} else {
					<span class="inline-flex items-center px-1.5 py-0.5 rounded-sm bg-sand-100 text-[10px] tracking-brand uppercase text-ink-700">
						{ r.TierLabel }
						if r.PayMethod != "" {
							<span class="ml-1">· { payMethodLabel(r.PayMethod) }</span>
						}
					</span>
				}
				if r.Relative != "" {
					<span class="text-ink-500">· { r.Relative }</span>
				} else {
					<span class="text-ink-500">· { r.At }</span>
				}
			</p>
		</a>
		<div class="shrink-0 text-right">
			<p class="yh-num text-[14px] sm:text-[15px] text-success tabular-nums">{ r.Amount }</p>
			if r.Credit != "" {
				<p class="text-[11px] text-ink-500 mt-1">{ r.Credit }</p>
			}
		</div>
	</li>
}
