package page

import (
 "github.com/mingicho/yuhada/internal/v2/view/component"
 "github.com/mingicho/yuhada/internal/v2/view/layout"
)

templ Members(p MembersProps) {
 @layout.Admin("회원 관리", "members") {
  <div class="px-4 py-5 sm:px-8 sm:py-10 max-w-admin-content mx-auto">
   @component.PageHeader("회원", "회원 관리", "") {
    <a href="/v2/admin/members/new" class="yh-btn yh-btn-primary">
     @component.Icon("user-plus", 14)
     <span class="ml-2">신규 회원</span>
    </a>
   }
   <form id="members-filters" method="GET" action="/v2/admin/members"
    hx-get="/v2/admin/members" hx-trigger="submit, change from:select"
    hx-target="#members-list" hx-swap="outerHTML" hx-push-url="true" hx-sync="#members-list:replace"
    class="flex flex-wrap items-end gap-3 mb-6">
    <input type="hidden" name="filter" value="1"/>
    <div class="w-full sm:w-auto sm:flex-1 sm:max-w-[360px]">
     <label for="members-q" class="yh-label">이름 또는 전화번호</label>
     <input id="members-q" class="yh-input" name="q" value={ p.Query } placeholder="회원 검색"
      hx-get="/v2/admin/members" hx-include="#members-filters" hx-trigger="keyup changed delay:250ms, search"
      hx-target="#members-list" hx-swap="outerHTML" hx-push-url="true" hx-sync="#members-list:replace"/>
    </div>
    <label class="block"><span class="yh-label">상태</span>
     <select name="status" class="yh-input">
      <option value="all" selected?={ p.Status == "all" || p.Status == "" }>전체</option>
      <option value="active" selected?={ p.Status == "active" }>활성</option>
      <option value="inactive" selected?={ p.Status == "inactive" }>비활성</option>
     </select>
    </label>
    <label class="block"><span class="yh-label">정렬</span>
     <select name="sort" class="yh-input">
      <option value="default" selected?={ p.Sort == "default" || p.Sort == "" }>최근 등록순</option>
      <option value="balance_desc" selected?={ p.Sort == "balance_desc" }>잔액 높은순</option>
      <option value="balance_asc" selected?={ p.Sort == "balance_asc" }>잔액 낮은순</option>
     </select>
    </label>
    <button type="submit" class="yh-btn yh-btn-secondary">조회</button>
   </form>
   @MembersResults(p)
  </div>
 }
}

templ MembersResults(p MembersProps) {
 <div id="members-list" class="yh-card overflow-hidden">
  <table class="hidden md:table w-full border-collapse">
   <thead class="bg-sand-100"><tr>
    <th scope="col" class="yh-eyebrow-xs text-left px-6 py-5">이름</th>
    <th scope="col" class="yh-eyebrow-xs text-left px-6 py-5">전화번호</th>
    <th scope="col" class="yh-eyebrow-xs text-right px-6 py-5">잔액</th>
   </tr></thead>
   <tbody id="members-desktop" class="yh-stagger">
    if len(p.Rows) == 0 {
     <tr><td colspan="3" class="text-center py-12 px-6 text-[13px] text-ink-500">조건에 맞는 회원이 없습니다.</td></tr>
    }
    @membersDesktopRows(p.Rows)
   </tbody>
  </table>
  <ul id="members-mobile" class="md:hidden list-none m-0 p-0 yh-stagger">
   if len(p.Rows) == 0 {
    <li class="text-center py-12 px-6 text-[13px] text-ink-500">조건에 맞는 회원이 없습니다.</li>
   }
   @membersMobileRows(p.Rows)
  </ul>
  @component.ListPaging(p.Paging)
 </div>
}

templ MembersAppend(p MembersProps) {
 <template>
  <tbody hx-swap-oob="beforeend:#members-desktop">
   @membersDesktopRows(p.Rows)
  </tbody>
 </template>
 <ul hx-swap-oob="beforeend:#members-mobile">
  @membersMobileRows(p.Rows)
 </ul>
 @component.ListPaging(p.Paging)
}

templ membersDesktopRows(rows []MemberRow) {
 for _, m := range rows {
  <tr data-member-id={ m.ID } class="border-t border-sand-200 hover:bg-sand-50 cursor-pointer" onclick={ templ.JSFuncCall("location.assign", "/v2/admin/members/"+m.ID) }>
   <th scope="row" class="px-6 py-5 text-[15px] text-left font-normal">
    <a href={ templ.SafeURL("/v2/admin/members/" + m.ID) } class="font-medium underline-offset-4 hover:underline">{ m.Name }</a>
    @memberStatus(m)
   </th>
   <td class="px-6 py-5 text-[14px] text-ink-700 tabular-nums">{ m.Phone }</td>
   <td class="px-6 py-5 text-right"><span class={ "yh-num text-[18px]", templ.KV("text-ink-500", m.ZeroBal) }>{ m.Balance }</span></td>
  </tr>
 }
}

templ membersMobileRows(rows []MemberRow) {
 for _, m := range rows {
  <li data-member-id={ m.ID } class="border-b border-sand-200 last:border-0 active:bg-sand-50">
   <a href={ templ.SafeURL("/v2/admin/members/" + m.ID) } class="flex items-center gap-3 px-5 py-4">
    <div class="flex-1 min-w-0">
     <p class="text-[15px] font-medium">{ m.Name }
      @memberStatus(m)
     </p>
     <p class="text-[12px] text-ink-500 tabular-nums mt-1">{ m.Phone }</p>
    </div>
    <p class={ "yh-num text-[16px] shrink-0", templ.KV("text-ink-500", m.ZeroBal) }>{ m.Balance }</p>
   </a>
  </li>
 }
}

templ memberStatus(m MemberRow) {
 if m.Inactive {
  <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded-sm text-[10px] text-danger border border-danger">비활성</span>
 }
 if m.Card == "" {
  <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded-sm border border-sand-300 text-[10px] text-ink-500">미발급</span>
 }
}
