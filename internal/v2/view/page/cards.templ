package page

import (
 "strconv"
 "github.com/mingicho/yuhada/internal/v2/view/component"
 "github.com/mingicho/yuhada/internal/v2/view/layout"
)

type CardsData struct {
 Issued, Active, Lost, UnissuedCount int64
 Cards []CardRow
 Query, Status string
 Paging component.ListPagingProps
}

type CardRow struct {
 MemberID, Name, Phone, Card, JoinedAt, Balance, Status string
 Active bool
}

templ Cards(d CardsData) {
 @layout.Admin("카드 관리", "cards") {
  <div class="px-4 py-5 sm:px-8 sm:py-10 max-w-admin-content mx-auto">
   @component.PageHeader("카드", "카드 관리", "")
   <section class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-3">
    @component.Stat("발급됨", fmtCount(d.Issued), "장")
    @component.Stat("활성", fmtCount(d.Active), "장")
    @component.Stat("분실/정지", fmtCount(d.Lost), "장")
    @component.Stat("미발급", fmtCount(d.UnissuedCount), "명")
   </section>
   <p class="text-[12px] text-ink-500 mb-6">전체 회원 기준 · 아래 검색 및 상태 필터와 무관</p>
   <form id="cards-filters" method="GET" action="/v2/admin/cards"
    hx-get="/v2/admin/cards" hx-trigger="submit, change from:select"
    hx-target="#cards-list" hx-swap="outerHTML" hx-push-url="true" hx-sync="#cards-list:replace"
    class="flex flex-wrap items-end gap-3 mb-6">
    <input type="hidden" name="filter" value="1"/>
    <div class="w-full sm:w-auto sm:flex-1 sm:max-w-[420px]">
     <label for="cards-q" class="yh-label">이름 · 전화번호 · 카드 UUID</label>
     <input id="cards-q" class="yh-input" name="q" value={ d.Query } placeholder="카드 또는 회원 검색"
      hx-get="/v2/admin/cards" hx-include="#cards-filters" hx-trigger="keyup changed delay:250ms, search"
      hx-target="#cards-list" hx-swap="outerHTML" hx-push-url="true" hx-sync="#cards-list:replace"/>
    </div>
    <label class="block"><span class="yh-label">카드 상태</span>
     <select name="status" class="yh-input">
      <option value="all" selected?={ d.Status == "all" || d.Status == "" }>전체</option>
      <option value="active" selected?={ d.Status == "active" }>활성 카드</option>
      <option value="lost" selected?={ d.Status == "lost" }>분실/정지 카드</option>
      <option value="unissued" selected?={ d.Status == "unissued" }>미발급</option>
     </select>
    </label>
    <button type="submit" class="yh-btn yh-btn-secondary">조회</button>
   </form>
   @CardsResults(d)
  </div>
 }
}

templ CardsResults(d CardsData) {
 <div id="cards-list" class="yh-card overflow-hidden">
  <div class="overflow-x-auto">
   <table class="hidden md:table w-full border-collapse">
    <thead class="bg-sand-100"><tr>
     <th scope="col" class="yh-eyebrow-xs text-left px-5 py-4">회원</th>
     <th scope="col" class="yh-eyebrow-xs text-left px-5 py-4">카드 UUID</th>
     <th scope="col" class="yh-eyebrow-xs text-left px-5 py-4">가입일</th>
     <th scope="col" class="yh-eyebrow-xs text-right px-5 py-4">상태</th>
    </tr></thead>
    <tbody id="cards-desktop">
     if len(d.Cards) == 0 {
      <tr><td colspan="4" class="text-center py-12 px-5 text-[13px] text-ink-500">조건에 맞는 카드 또는 회원이 없습니다.</td></tr>
     }
     @cardsDesktopRows(d.Cards)
    </tbody>
   </table>
  </div>
  <ul id="cards-mobile" class="md:hidden list-none m-0 p-0">
   if len(d.Cards) == 0 {
    <li class="text-center py-12 px-5 text-[13px] text-ink-500">조건에 맞는 카드 또는 회원이 없습니다.</li>
   }
   @cardsMobileRows(d.Cards)
  </ul>
  @component.ListPaging(d.Paging)
 </div>
}

templ CardsAppend(d CardsData) {
 <template>
  <tbody hx-swap-oob="beforeend:#cards-desktop">
   @cardsDesktopRows(d.Cards)
  </tbody>
 </template>
 <ul hx-swap-oob="beforeend:#cards-mobile">
  @cardsMobileRows(d.Cards)
 </ul>
 @component.ListPaging(d.Paging)
}

templ cardsDesktopRows(rows []CardRow) {
 for _, c := range rows {
  <tr data-card-member-id={ c.MemberID } class="border-t border-sand-200 hover:bg-sand-50 cursor-pointer" onclick={ templ.JSFuncCall("location.assign", "/v2/admin/members/"+c.MemberID) }>
   <th scope="row" class="px-5 py-4 text-left font-normal">
    <a href={ templ.SafeURL("/v2/admin/members/" + c.MemberID) } class="text-[14px] font-medium hover:underline underline-offset-4">{ c.Name }</a>
    <p class="text-[12px] text-ink-500 tabular-nums mt-1">{ c.Phone }</p>
   </th>
   <td class="px-5 py-4"><span class="font-mono text-[12px] text-ink-700 break-all">{ cardUUIDLabel(c) }</span></td>
   <td class="px-5 py-4 text-[12px] text-ink-700 tabular-nums whitespace-nowrap">{ c.JoinedAt }</td>
   <td class="px-5 py-4 text-right">
    @cardStatus(c)
   </td>
  </tr>
 }
}

templ cardsMobileRows(rows []CardRow) {
 for _, c := range rows {
  <li data-card-member-id={ c.MemberID } class="border-b border-sand-200 last:border-0 active:bg-sand-50">
   <a href={ templ.SafeURL("/v2/admin/members/" + c.MemberID) } class="block px-5 py-4">
    <div class="flex items-center justify-between gap-3">
     <p class="text-[15px] font-medium">{ c.Name }</p>
     @cardStatus(c)
    </div>
    <p class="text-[12px] text-ink-500 mt-1 tabular-nums">{ c.Phone } · 잔액 { c.Balance }</p>
    <p class="font-mono text-[12px] text-ink-700 break-all mt-2">{ cardUUIDLabel(c) }</p>
    <p class="text-[11px] text-ink-500 mt-1">가입 { c.JoinedAt }</p>
   </a>
  </li>
 }
}

templ cardStatus(c CardRow) {
 if c.Status == "unissued" {
  <span class="inline-flex items-center px-2 py-1 rounded-sm border border-sand-300 text-[11px] text-ink-500">미발급</span>
  if !c.Active {
   <span class="ml-1 inline-flex items-center text-[11px] text-danger">비활성</span>
  }
 } else if c.Active {
  <span class="inline-flex items-center px-2 py-1 rounded-sm bg-sand-100 text-[11px] text-success">활성</span>
 } else {
  <span class="inline-flex items-center px-2 py-1 rounded-sm border border-danger text-[11px] text-danger">분실/정지</span>
 }
}

func cardUUIDLabel(c CardRow) string {
 if c.Card == "" { return "카드 미발급 · 회원 상세에서 발급" }
 return c.Card
}

func fmtCount(n int64) string { return strconv.FormatInt(n, 10) }
