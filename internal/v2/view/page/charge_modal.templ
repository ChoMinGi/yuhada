package page

import (
	"strconv"
	"github.com/mingicho/yuhada/internal/util"
	"github.com/mingicho/yuhada/internal/v2/view/component"
)

// ChargeModal — GET /v2/admin/members/{id}/charge/modal partial.
//
// 카드 클릭 즉시 실행이 아니라 모달 안에서 확인 화면(step=confirm)으로
// 슬라이드 전환한 뒤 명시적 [확인] 을 눌러야 실행. 사장님 실수 방지.
templ ChargeModal(p ChargeModalProps) {
	<div
		class="yh-card w-full max-w-[560px] max-h-[90vh] overflow-y-auto"
		x-data={ chargeModalAlpine(p) }
		x-init="$nextTick(() => shown = true)"
		x-show="shown"
		x-transition:enter="transition ease-out duration-250"
		x-transition:enter-start="opacity-0 scale-95"
		x-transition:enter-end="opacity-100 scale-100"
	>
		<header class="p-6 pb-0 flex items-start justify-between gap-6">
			<div>
				<p class="yh-eyebrow mb-2">충전</p>
				<h2 class="yh-headline-m" x-text="step === 'confirm' ? '확인' : '정액권 충전'"></h2>
				<p class="yh-body-sm text-ink-500 mt-1" x-text="step === 'confirm' ? '이대로 진행할까요?' : '상품을 선택하거나 기타 금액을 입력하세요.'"></p>
			</div>
			<button class="p-1.5 text-ink-500" x-on:click="$dispatch('closemodal')" aria-label="닫기">
				@component.Icon("x", 18)
			</button>
		</header>

		<!-- 슬라이드 컨테이너 -->
		<div class="p-6 relative">
			<!-- STEP 1: 선택 화면 -->
			<div
				x-show="step === 'grid'"
				x-transition:enter="transition ease-out duration-250"
				x-transition:enter-start="opacity-0 -translate-x-6"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 -translate-x-6"
			>
				if len(p.Plans) == 0 {
					<div class="text-center py-8">
						<p class="yh-body-sm text-ink-500">활성 플랜이 없습니다. 먼저 <a class="underline" href="/v2/admin/settings/plans">충전 보너스 설정</a>에서 상품을 등록하세요.</p>
					</div>
				} else {
					<!-- 카드 결제 섹션 -->
					<section class="mb-4 sm:mb-6">
						<h3 class="yh-eyebrow mb-2 sm:mb-3">💳 &nbsp; 카드 결제</h3>
						<div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3">
							for _, plan := range p.Plans {
								if plan.PaymentMethod == "card" {
									@chargePlanCard(plan)
								}
							}
						</div>
					</section>

					<!-- 현금 결제 섹션 -->
					<section>
						<h3 class="yh-eyebrow mb-2 sm:mb-3">💵 &nbsp; 현금 결제</h3>
						<div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3">
							for _, plan := range p.Plans {
								if plan.PaymentMethod == "cash" {
									@chargePlanCard(plan)
								}
							}
						</div>
					</section>
				}

				<!-- 기타 금액 -->
				<section class="mt-6 pt-6 border-t border-sand-200">
					<h3 class="yh-eyebrow mb-3">💰 &nbsp; 기타 금액 <span class="text-ink-500 normal-case tracking-normal text-[11px] ml-1">정액권 없이 자유 충전</span></h3>
					<div class="yh-card p-4">
						<div class="flex items-baseline gap-2 border-b border-sand-300 pb-2 focus-within:border-ink-900">
							<span class="yh-num text-[26px] text-ink-500">₩</span>
							<input
								type="text"
								inputmode="numeric"
								autocomplete="off"
								placeholder="0"
								x-model="otherStr"
								x-on:input="other = parseInt((otherStr||'').replace(/[^0-9]/g,''))||0; otherStr = other>0 ? other.toLocaleString('ko-KR') : ''"
								class="yh-num flex-1 bg-transparent border-0 outline-none text-[26px] text-ink-900 p-0"
							/>
						</div>

						<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4">
							for _, amount := range []int64{50000, 100000, 200000, 500000} {
								<button type="button" x-on:click={ "other = " + strconv.FormatInt(amount, 10) + "; otherStr = other.toLocaleString('ko-KR')" } class="h-11 border border-sand-300 rounded text-[11px] tracking-brand uppercase tabular-nums">{ util.FormatKRW(amount) }</button>
							}
						</div>
						<label class="yh-label mt-5" for="charge-memo">메모</label>
						<input id="charge-memo" type="text" maxlength="50" x-model="memo" placeholder="예: 현금, 계좌이체" class="yh-input"/>
						<div class="flex flex-wrap gap-1.5 mt-3">
							for _, preset := range []string{"현금", "계좌이체", "카드"} {
								<button type="button" x-on:click={ "memo = " + templJSString(preset) } class="px-2.5 h-7 border border-sand-300 rounded-sm text-[11px] tracking-brand uppercase">{ preset }</button>
							}
						</div>
						<div class="mt-5 pt-4 border-t border-sand-200 text-[13px]">
							<p class="flex justify-between"><span>현재 잔액</span><span x-text="'₩' + balance.toLocaleString('ko-KR')"></span></p>
							<p class="flex justify-between mt-2"><span>충전 후 잔액</span><span class="yh-num" x-text="'₩' + (balance + other).toLocaleString('ko-KR')"></span></p>
						</div>
						<p x-show="error" x-cloak x-text="error" role="alert" class="text-[13px] text-danger mt-4"></p>
						<button type="button" x-on:click="pendOther()" x-bind:disabled="other <= 0 || submitting" class="yh-btn yh-btn-primary w-full mt-5">
							<span x-show="!submitting">충전하기</span><span x-show="submitting" x-cloak>처리 중...</span>
						</button>
					</div>
				</section>
			</div>

			<!-- STEP 2: 확인 화면 -->
			<div
				x-show="step === 'confirm'"
				x-cloak
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-x-8"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 translate-x-8"
				class="pb-2"
			>
				<div class="yh-card p-6 sm:p-8 flex flex-col items-center text-center gap-3">
					<p class="yh-eyebrow-xs text-ink-500">CONFIRM</p>
					<p class="text-[15px] sm:text-[16px] text-ink-900">
						<span class="font-semibold" x-text="memberName"></span>님에게
					</p>
					<div>
						<p x-show="pending && pending.type === 'plan'" class="mb-1">
							<span class="inline-flex items-center px-2 py-0.5 rounded-sm bg-sand-100 text-[11px] tracking-brand uppercase text-ink-700" x-text="pending && pending.label"></span>
						</p>
						<p class="yh-num text-[32px] sm:text-[38px] text-success whitespace-nowrap" x-text="pending && pending.amountStr"></p>
						<p x-show="pending && pending.type === 'plan'" class="text-[12px] text-ink-500 mt-1">
							받는 돈 <span x-text="pending && pending.priceStr"></span>
						</p>
					</div>
					<p x-show="pending && pending.type === 'other' && memo" x-text="memo" class="text-[13px] text-ink-700"></p>
					<p class="text-[13px] text-ink-500 mt-1">위 금액을 충전하시겠습니까?</p>
					<div class="w-full border-t border-sand-200 pt-4 mt-2 text-[13px]">
						<p class="flex justify-between"><span>현재 잔액</span><span x-text="'₩' + balance.toLocaleString('ko-KR')"></span></p>
						<p class="flex justify-between mt-2"><span>충전 후 잔액</span><span class="yh-num" x-text="'₩' + (balance + (pending ? pending.amount : 0)).toLocaleString('ko-KR')"></span></p>
					</div>
				</div>

				<p x-show="error" x-cloak x-text="error" role="alert" class="text-[13px] text-danger mt-4"></p>
				<div class="flex gap-3 mt-6">
					<button
						type="button"
						x-on:click="cancel()"
						class="yh-btn yh-btn-ghost flex-1"
						x-bind:disabled="submitting"
					>취소</button>
					<button
						type="button"
						x-on:click="submit()"
						class="yh-btn yh-btn-primary flex-1"
						x-bind:disabled="submitting"
					>
						<span x-show="!submitting">충전 확정</span>
						<span x-show="submitting" x-cloak>처리 중...</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}

// chargePlanCard — 정액권 카드 (type=button, Alpine 으로 pending 세팅 → 슬라이드 confirm).
templ chargePlanCard(plan PlanRow) {
	<button
		type="button"
		data-plan-id={ plan.ID }
		data-label={ plan.TierLabel + " · " + payMethodLabel(plan.PaymentMethod) }
		data-credit={ util.FormatKRW(plan.CreditAmount) }
		data-amount={ strconv.FormatInt(plan.CreditAmount, 10) }
		data-price={ util.FormatKRW(plan.Price) }
		x-on:click="pendPlan($el)"
		x-bind:disabled="submitting"
		class={ "yh-card p-3 sm:p-4 text-left flex flex-col gap-1 sm:gap-1.5 border-2 border-transparent hover:border-ink-900 transition",
			templ.KV("col-span-2 sm:col-span-1", plan.TierAmount == 500000) }
	>
		<p class="yh-eyebrow-xs">{ plan.TierLabel }</p>
		<p class="yh-num text-[20px] sm:text-[22px] text-success mt-1 whitespace-nowrap">+{ util.FormatKRW(plan.CreditAmount) }</p>
		<p class="text-[11px] text-ink-500">받는 돈 { util.FormatKRW(plan.Price) }</p>
	</button>
}

// chargeModalAlpine — Alpine.js 상태 객체 (JSON 리터럴).
// step: grid | confirm.  pending: 선택된 상품 or 기타 금액.
// submit(): 명시적 JSON 성공 확인 후 회원 상세 영역 갱신.
func chargeModalAlpine(p ChargeModalProps) string {
	return `{
		shown: false,
		step: 'grid',
		submitting: false,
		other: 100000,
		otherStr: '100,000',
		memo: '',
		error: '',
		balance: ` + strconv.FormatInt(p.BalanceInt, 10) + `,
		memberID: '` + p.MemberID + `',
		memberName: ` + templJSString(p.MemberName) + `,
		pending: null,
		pendPlan(el) {
			this.pending = {
				type: 'plan',
				planId: el.dataset.planId,
				amount: Number(el.dataset.amount),
				label:  el.dataset.label,
				amountStr: '+' + el.dataset.credit,
				priceStr:  el.dataset.price,
			};
			this.step = 'confirm';
		},
		pendOther() {
			if (this.other <= 0 || this.submitting) return;
			this.pending = { type: 'other', amount: this.other, amountStr: '+₩' + this.other.toLocaleString('ko-KR') };
			this.submit();
		},
		cancel() { this.step = 'grid'; },
		async submit() {
			if (this.submitting || !this.pending) return;
			// 전역 락: Alpine 인스턴스가 어떤 이유로든 중복 초기화되어도 fetch가 두 번 나가지 않도록.
			if (window.__v2ChargeInFlight) return;
			window.__v2ChargeInFlight = true;
			this.submitting = true;
			const body = new URLSearchParams();
			if (this.pending.type === 'plan') body.append('plan_id', this.pending.planId);
			else { body.append('amount', String(this.pending.amount)); body.append('memo', this.memo || ''); }
			this.error = '';
			try {
				const result = await window.yhSubmitWallet('/v2/admin/members/' + this.memberID + '/charge', body);
				if (!result) return;
				if (await window.yhRefreshMember(result.redirect || ('/v2/admin/members/' + this.memberID))) window.__v2ChargeInFlight = false;
			} catch (e) {
				if (e.uncertain) {
					alert(e.message);
					window.location.assign('/v2/admin/members/' + this.memberID);
					return;
				}
				this.submitting = false;
				window.__v2ChargeInFlight = false;
				this.error = e.message || '충전하지 못했습니다.';
			}
		}
	}`
}

// templJSString — 한글 회원 이름을 Alpine 문자열 리터럴로 안전하게 인젝션.
func templJSString(s string) string {
	// 최소 이스케이프: 백슬래시 + 작은따옴표.
	out := ""
	for _, r := range s {
		switch r {
		case '\\':
			out += `\\`
		case '\'':
			out += `\'`
		case '\n':
			out += `\n`
		case '\r':
			out += `\r`
		default:
			out += string(r)
		}
	}
	return "'" + out + "'"
}
