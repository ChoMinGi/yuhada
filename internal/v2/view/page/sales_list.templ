package page

import "strconv"
import "github.com/mingicho/yuhada/internal/v2/view/layout"
import "github.com/mingicho/yuhada/internal/v2/view/component"

templ SalesList(p SalesListProps) {
	@layout.Admin(p.Title, "sales") {
		<div class="px-4 py-5 sm:px-8 sm:py-10 max-w-admin-content mx-auto">
			<a href="/v2/admin/sales" class="text-[13px] underline underline-offset-4">매출 대시보드</a>
			<h1 class="yh-headline-l mt-5 mb-6">{ p.Title }</h1>
			<form action="/v2/admin/sales/list" method="GET" class="flex flex-wrap gap-3 items-end mb-6">
				<div><label for="sales-list-kind" class="block text-[12px] mb-2">목록</label><select id="sales-list-kind" name="kind" class="yh-input">
					<option value="recent" selected?={p.Kind=="recent"}>판매 이력</option>
					<option value="top" selected?={p.Kind=="top"}>고객별 판매 금액</option>
					<option value="recharge" selected?={p.Kind=="recharge"}>재충전 안내 후보</option>
				</select></div>
				<div><label for="sales-list-period" class="block text-[12px] mb-2">판매 기간</label><select id="sales-list-period" name="period" class="yh-input">
					<option value="today" selected?={p.Period=="today"}>오늘</option>
					<option value="this-week" selected?={p.Period=="this-week"}>이번 주</option>
					<option value="this-month" selected?={p.Period=="this-month"}>이번 달</option>
					<option value="all" selected?={p.Period=="all"}>전체</option>
					<option value="custom" selected?={p.Period=="custom"}>기간 지정</option>
				</select></div>
				<div><label for="sales-list-from" class="block text-[12px] mb-2">시작일</label><input id="sales-list-from" type="date" name="from" value={p.From} class="yh-input"/></div>
				<div><label for="sales-list-to" class="block text-[12px] mb-2">종료일</label><input id="sales-list-to" type="date" name="to" value={p.To} class="yh-input"/></div>
				<div><label for="sales-list-q" class="block text-[12px] mb-2">고객 이름</label><input id="sales-list-q" name="q" value={p.Query} class="yh-input" placeholder="이름 검색"/></div>
				<button type="submit" class="yh-btn yh-btn-primary">적용</button>
			</form>
			@SalesListResults(p)
		</div>
	}
}

templ SalesListResults(p SalesListProps) {
	<section id="sales-list-results" class="yh-card overflow-hidden">
		<p class="p-4 text-[12px] text-ink-500 border-b border-sand-200">{p.Scope} · 전체 {strconv.Itoa(p.Total)}{p.Paging.Unit}</p>
		<div id="sales-list-rows" class="divide-y divide-sand-200">
			if len(p.Rows)==0 {
				<p class="p-8 text-center text-ink-500">조건에 맞는 기록이 없습니다.</p>
			}
			@salesListRows(p.Rows)
		</div>
		@component.ListPaging(p.Paging)
	</section>
}

templ salesListRows(rows []SalesListRow) {
	for _,row:=range rows {
		<a href={templ.SafeURL(row.Href)} data-record-id={row.ID} class="flex items-center justify-between gap-4 px-4 sm:px-6 py-4 hover:bg-sand-50">
			<div class="min-w-0"><p class="text-[14px] break-words">{row.Name}</p><p class="text-[12px] text-ink-500 mt-1">{row.Detail}</p><p class="text-[11px] text-ink-500 mt-1">{row.Date}</p></div>
			<p class="yh-num text-[18px] shrink-0">{row.Amount}</p>
		</a>
	}
}

templ SalesListAppend(p SalesListProps) {
	<div hx-swap-oob="beforeend:#sales-list-rows">
		@salesListRows(p.Rows)
	</div>
	@component.ListPaging(p.Paging)
}
