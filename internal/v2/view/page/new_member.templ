package page

import (
	"fmt"
	"github.com/mingicho/yuhada/internal/v2/view/component"
	"github.com/mingicho/yuhada/internal/v2/view/layout"
)

// NewMember — /v2/admin/members/new. v1 톤 재사용.
// 전화번호 자동 포맷 + 카드 UUID 자동 생성 Alpine 로직 그대로.
templ NewMember(p NewMemberProps) {
	@layout.Admin("신규 회원 등록", "members") {
		<div class="px-4 py-5 sm:px-8 sm:py-10 max-w-admin-form mx-auto">
			<a href="/v2/admin/members" class="yh-eyebrow-xs inline-flex items-center gap-1.5 mb-6">
				@component.Icon("chevron-left", 12)
				회원 목록
			</a>
			<header class="mb-10">
				<p class="yh-eyebrow mb-3">신규 회원</p>
				<h1 class="yh-headline-l text-[26px] sm:text-[32px]">신규 회원 등록</h1>
			</header>

			<form
				method="POST"
				action="/v2/admin/members"
				class="flex flex-col gap-6"
				hx-boost="false"
				x-data="{
					phone: '',
					card: '',
					amountStr: '',
					formatPhone() {
						const s = this.phone.replace(/\D/g,'').slice(0,11);
						this.phone = s.length >= 8 ? s.slice(0,3)+'-'+s.slice(3,7)+'-'+s.slice(7)
						           : s.length >= 4 ? s.slice(0,3)+'-'+s.slice(3)
						           : s;
					},
					genUuid() { this.card = crypto.randomUUID().slice(0,8).toUpperCase(); }
				}"
			>
				<div>
					<label for="new-name" class="yh-label">
						이름<span class="text-danger ml-1">*</span>
					</label>
					<input id="new-name" name="name" class="yh-input" autofocus required value={ p.Name } placeholder="김지영"/>
				</div>
				<div>
					<label for="new-phone" class="yh-label">
						전화번호<span class="text-danger ml-1">*</span>
					</label>
					<input
						id="new-phone"
						name="phone"
						inputmode="numeric"
						class="yh-input tabular-nums"
						placeholder="010-0000-0000"
						required
						value={ p.Phone }
						x-init={ "phone = " + templJSString(p.Phone) }
						x-model="phone"
						x-on:input="formatPhone()"
					/>
				</div>

				<div>
					<label for="new-card" class="yh-label">
						카드 UUID
						<span class="text-[10px] text-ink-500 normal-case tracking-normal ml-1.5">선택</span>
					</label>
					<div class="flex items-center border-b border-sand-300 focus-within:border-ink-900">
						<input
							id="new-card"
							name="card"
							class="flex-1 bg-transparent border-0 outline-none py-3 text-[15px] placeholder:text-ink-500"
							placeholder="비워두면 카드 없이 등록됩니다"
							value={ p.Card }
							x-init={ "card = " + templJSString(p.Card) }
							x-model="card"
						/>
						<button
							type="button"
							x-on:click="genUuid()"
							class="inline-flex items-center gap-1.5 text-[11px] tracking-brand uppercase py-3"
						>
							@component.Icon("rotate-ccw", 12)
							자동 생성
						</button>
					</div>
				</div>

				<div>
					<label for="new-amount" class="yh-label">초기 충전 금액 <span class="text-[10px] text-ink-500 normal-case tracking-normal ml-1.5">선택</span></label>
					<input
						id="new-amount"
						name="amount"
						type="text"
						inputmode="numeric"
						class="yh-input tabular-nums"
						placeholder="0"
						value={ p.AmountStr }
						x-init={ "amountStr = " + templJSString(p.AmountStr) }
						x-model="amountStr"
						x-on:input="const n = parseInt((amountStr || '').replace(/[^0-9]/g, ''), 10) || 0; amountStr = n > 0 ? n.toLocaleString('ko-KR') : ''"
					/>
					<p class="text-[12px] text-ink-500 mt-2">등록과 함께 잔액을 충전합니다. 비워두면 회원만 등록됩니다.</p>
					<div class="grid grid-cols-4 gap-2 mt-3">
						for _,amount:=range []int64{100000,300000,500000,1000000} {
							<button type="button" class="yh-btn yh-btn-secondary text-[11px] px-1" x-on:click={fmt.Sprintf("amountStr = (%d).toLocaleString('ko-KR')",amount)}>{fmt.Sprintf("%d만원",amount/10000)}</button>
						}
					</div>
				</div>

				<div>
					<label for="new-memo" class="yh-label">
						메모
						<span class="text-[10px] text-ink-500 normal-case tracking-normal ml-1.5">선택</span>
					</label>
					<textarea id="new-memo" name="memo" rows="3" class="yh-input" placeholder="특이사항, 선호 디자이너 등">{ p.Memo }</textarea>
				</div>

				if p.ErrorMsg != "" {
					<div class="text-[12px] text-danger">{ p.ErrorMsg }</div>
				}

				<footer class="flex gap-3 pt-4">
					<a href="/v2/admin/members" class="yh-btn yh-btn-ghost flex-1 text-center">취소</a>
					<button type="submit" class="yh-btn yh-btn-primary flex-1">등록하기</button>
				</footer>
			</form>
		</div>
	}
}
