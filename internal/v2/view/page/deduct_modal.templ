package page

import (
	"fmt"

	"github.com/mingicho/yuhada/internal/util"
	"github.com/mingicho/yuhada/internal/v2/view/component"
)

// DeductModal — GET /v2/admin/members/{id}/deduct/modal partial.
// 기존 차감 흐름: 금액·메모·차감 후 잔액 확인 후 한 번 제출.
templ DeductModal(p DeductModalProps) {
	<div
		class="yh-card w-full max-w-[440px] max-h-[90vh] overflow-y-auto"
		x-data={ deductModalAlpine(p) }
		x-init="$nextTick(() => shown = true)"
		x-show="shown"
		x-transition:enter="transition ease-out duration-250"
		x-transition:enter-start="opacity-0 scale-95"
		x-transition:enter-end="opacity-100 scale-100"
	>
		<header class="p-8 pb-0 flex items-start justify-between gap-6">
			<div>
				<p class="yh-eyebrow mb-2">차감</p>
				<h2 class="yh-headline-m">차감</h2>
			</div>
			<button class="p-1.5 text-ink-500" x-on:click="$dispatch('closemodal')" aria-label="닫기">
				@component.Icon("x", 18)
			</button>
		</header>

		<div class="p-8 relative">
			<!-- STEP 1: 입력 화면 -->
			<div
				x-show="step === 'form'"
				x-transition:enter="transition ease-out duration-250"
				x-transition:enter-start="opacity-0 -translate-x-6"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 -translate-x-6"
			>
				<label class="yh-label">차감 금액</label>
				<div class="flex items-baseline gap-2 border-b border-sand-300 pb-2 focus-within:border-ink-900">
					<span class="yh-num text-[40px] text-ink-500">₩</span>
					<input
						type="text"
						inputmode="numeric"
						autocomplete="off"
						autofocus
						x-model="amountStr"
						x-on:input="amount = parseInt((amountStr||'').replace(/[^0-9]/g, '')) || 0; amountStr = amount > 0 ? amount.toLocaleString('ko-KR') : ''"
						class="yh-num flex-1 bg-transparent border-0 outline-none text-[40px] text-ink-900 p-0"
					/>
				</div>

				if len(p.DeductAmts) > 0 {
					<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-6">
						for _, n := range p.DeductAmts {
							<button
								type="button"
								x-on:click={ fmt.Sprintf("setAmount(%d)", n) }
								x-bind:class={ fmt.Sprintf("amount === %d ? 'bg-ink-900 text-sand-50 border-ink-900' : 'bg-transparent text-ink-900 border-sand-300 hover:border-ink-900'", n) }
								class="h-11 border rounded text-[11px] tracking-brand uppercase tabular-nums transition"
							>
								{ util.FormatKRW(n) }
							</button>
						}
					</div>
				}

				<div class="mt-7">
					<label class="yh-label" for="deduct-service">시술 / 메모</label>
					<input
						id="deduct-service"
						type="text"
						maxlength="50"
						x-model="service"
						placeholder="예: 디자이너 컷, 매직스트레이트"
						class="yh-input"
					/>
					if len(p.ServiceMemos) > 0 {
						<div class="flex flex-wrap gap-1.5 mt-3">
							for _, preset := range p.ServiceMemos {
								<button
									type="button"
									x-on:click={ fmt.Sprintf("service = %q", preset) }
									x-bind:class={ fmt.Sprintf("service === %q ? 'bg-ink-900 text-sand-50 border-ink-900' : 'bg-transparent text-ink-700 border-sand-300 hover:border-ink-900'", preset) }
									class="px-2.5 h-7 border rounded-sm text-[11px] tracking-brand uppercase transition"
								>
									{ preset }
								</button>
							}
						</div>
					}
				</div>

				<div class="mt-7 py-4 border-t border-sand-200 text-[13px]">
					<p class="flex justify-between"><span>현재 잔액</span><span x-text="'₩' + balance.toLocaleString('ko-KR')"></span></p>
					<p class="flex justify-between mt-2"><span>차감 후 잔액</span><span class="yh-num" x-bind:class="insufficient ? 'text-danger' : 'text-ink-900'" x-text="'₩' + (balance - amount).toLocaleString('ko-KR')"></span></p>
					<p x-show="insufficient" x-cloak class="text-danger mt-3" role="alert" x-text="'잔액 부족 — 최대 ₩' + balance.toLocaleString('ko-KR') + '까지 차감할 수 있습니다.'"></p>
				</div>
				<p x-show="error" x-cloak x-text="error" role="alert" class="text-[13px] text-danger mt-4"></p>
				<div class="flex gap-3 mt-8">
					<button type="button" class="yh-btn yh-btn-ghost flex-1" x-on:click="$dispatch('closemodal')">취소</button>
					<button
						type="button"
						class="yh-btn yh-btn-primary flex-1"
						x-on:click="submit()"
						x-bind:disabled="amount <= 0 || insufficient || submitting"
					><span x-show="!submitting">차감하기</span><span x-show="submitting" x-cloak>처리 중...</span></button>
				</div>
			</div>

		</div>
	</div>
}

// deductModalAlpine — Alpine 상태 (JSON 리터럴).
// submit(): JSON 성공 확인 후 회원 상세 영역 갱신.
func deductModalAlpine(p DeductModalProps) string {
	return `{
		shown: false,
		step: 'form',
		submitting: false,
		amount: 50000,
		amountStr: '50,000',
		balance: ` + fmt.Sprintf("%d", p.BalanceInt) + `,
		error: '',
		get insufficient() { return this.amount > this.balance; },
		service: '',
		memberID: '` + p.MemberID + `',
		memberName: ` + templJSString(p.MemberName) + `,
		setAmount(n) { this.amount = n; this.amountStr = n.toLocaleString('ko-KR'); },
		async submit() {
			if (this.submitting || this.amount <= 0 || this.insufficient) return;
			if (window.__v2DeductInFlight) return;
			window.__v2DeductInFlight = true;
			this.submitting = true;
			const body = new URLSearchParams();
			body.append('amount', String(this.amount));
			body.append('service_name', this.service || '');
			this.error = '';
			try {
				const result = await window.yhSubmitWallet('/v2/admin/members/' + this.memberID + '/deduct', body);
				if (!result) return;
				if (await window.yhRefreshMember(result.redirect || ('/v2/admin/members/' + this.memberID))) window.__v2DeductInFlight = false;
			} catch (e) {
				if (e.uncertain) {
					alert(e.message);
					window.location.assign('/v2/admin/members/' + this.memberID);
					return;
				}
				this.submitting = false;
				window.__v2DeductInFlight = false;
				this.error = e.message || '차감하지 못했습니다.';
			}
		}
	}`
}
