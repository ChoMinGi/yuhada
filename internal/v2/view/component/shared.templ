// Package component — v2 재사용 컴포넌트.
package component

// Icon — Lucide 스타일 SVG 인라인. v2 는 v1 internal/ui 를 import 하지 않고
// 자주 쓰는 아이콘만 최소 재구현 (isolation-rules §1-2 준수).
//
// 지원되는 name: chevron-left, chevron-right, plus, pencil, search,
// user-plus, trending-up, trending-down, x, alert-triangle,
// layout-dashboard, users, package, log-out, menu, refresh-cw.
templ Icon(name string, size int) {
	if name == "chevron-left" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
	} else if name == "chevron-right" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
	} else if name == "plus" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
	} else if name == "pencil" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
	} else if name == "search" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
	} else if name == "user-plus" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 21a8 8 0 0 1 13.292-6"></path><circle cx="10" cy="8" r="5"></circle><path d="M19 16v6"></path><path d="M22 19h-6"></path></svg>
	} else if name == "trending-up" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>
	} else if name == "trending-down" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>
	} else if name == "x" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
	} else if name == "alert-triangle" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
	} else if name == "layout-dashboard" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>
	} else if name == "users" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
	} else if name == "package" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"></path><path d="m7.5 4.27 9 5.15"></path></svg>
	} else if name == "log-out" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
	} else if name == "menu" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></svg>
	} else if name == "refresh-cw" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
	} else if name == "rotate-ccw" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
	} else if name == "credit-card" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M2 10h20"></path></svg>
	} else if name == "receipt" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v18l4-2 4 2 4-2 4 2V3l-4 2-4-2-4 2-4-2Z"></path><path d="M8 9h8M8 13h6"></path></svg>
	} else if name == "trash-2" {
		<svg xmlns="http://www.w3.org/2000/svg" width={ intToStr(size) } height={ intToStr(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>
	} else {
		<span aria-hidden="true"></span>
	}
}

// PageHeader — eyebrow + title + 우측 액션 슬롯.
templ PageHeader(eyebrow, title, description string) {
	<header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-6 mb-8 sm:mb-10">
		<div class="min-w-0 flex-1">
			if eyebrow != "" {
				<p class="yh-eyebrow mb-2 sm:mb-3">{ eyebrow }</p>
			}
			<h1 class="yh-headline-l" style="font-size:28px">{ title }</h1>
			if description != "" {
				<p class="yh-body-sm mt-2 text-ink-500">{ description }</p>
			}
		</div>
		<div class="shrink-0">
			{ children... }
		</div>
	</header>
}

// Stat — KPI 카드. v1 과 동일 톤.
templ Stat(label, value, unit string) {
	<div class="yh-card px-5 py-4 sm:p-6 flex flex-row items-center justify-between gap-4 sm:block">
		<p class="yh-eyebrow shrink-0 sm:mb-3">{ label }</p>
		<p class="yh-num text-[22px] sm:text-[36px] text-right sm:text-left">
			{ value }
			if unit != "" {
				<span class="ml-1 font-sans text-[11px] font-normal tracking-brand uppercase text-ink-500">{ unit }</span>
			}
		</p>
	</div>
}

// intToStr — templ 표현식에서 int → string. fmt.Sprintf 를 매번 부르지 않기 위한 헬퍼.
func intToStr(n int) string {
	// -128..128 정도 범위. 아이콘 size 인자 전용.
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	buf := [4]byte{}
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		buf[i] = '-'
	}
	return string(buf[i:])
}
